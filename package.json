{
  "name": "dsh-asr-realtime",
  "version": "0.5.0",
  "private": true,
  "description": "Realtime speech input for DeepSeek Harness with live captions, recoverable transcripts and GitHub-maintained releases.",
  "license": "MIT",
  "icon": "icon.svg",
  "repository": {"type": "git", "url": "git+https://github.com/QR-0W/DSH-ASR-Realtime.git"},
  "homepage": "https://github.com/QR-0W/DSH-ASR-Realtime#readme",
  "bugs": {"url": "https://github.com/QR-0W/DSH-ASR-Realtime/issues"},
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "locale", "icon.svg", "cordis.patch.yml", "README.md", "README.zh-CN.md", "CHANGELOG.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "engines": {"node": "^22.19.0 || >=24.0.0", "dsh": "0.2.1-rc.1 || 0.2.1-rc.2"},
  "packageManager": "pnpm@10.18.0",
  "keywords": ["dsh-plugin", "deepseek-harness", "voice-input", "dashscope", "asr"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "link:runtime": "node scripts/link-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "verify:package": "npm run build && node -e \"require('node:fs').mkdirSync('output', { recursive: true })\" && npm pack --ignore-scripts --pack-destination output && node scripts/verify-package.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-renderer"]}
  },
  "dependencies": {"ws": "^8.18.3"},
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.2.0"
  },
  "pnpm": {"overrides": {"fflate@0.8.2": "0.8.3"}},
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-test-renderer": "18.3.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
